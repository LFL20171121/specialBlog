{
  "default": true,
  
  // MD013: 单行字符长度限制（默认80字符，写博客长句和中文时极易频繁报错，直接关闭）
  "MD013": false,

  // MD033: 禁止在 Markdown 中使用内联 HTML（Astro 博客经常使用 <div>、<span>、<details> 自定义样式，直接关闭）
  "MD033": false,
  
  "MD032": false,

  // MD041: 文件第一行必须是顶级一级标题 H1（因为有 Frontmatter --- 头部，必报此错，关闭）
  "MD041": false,

  // MD025: 单一顶级标题限制（博客通常在 Frontmatter 里定义 title，正文如果再写 # 标题会报错，关闭）
  "MD025": false,

  // MD024: 重复标题报错（博客中如果有多处 "总结"、"参考资料"、"步骤" 会报错，关闭或设置为兄弟级别校验）
  "MD024": {
    "siblings_only": true
  },

  // MD029: 有序列表数字递增限制（允许全部写 1. 自动排序）
  "MD029": false,

  // MD036: 禁止用加粗代替标题（写技术博客强调时常用，按需关闭）
  "MD036": false,

  // MD045: 图片必须带有 alt 描述文本（可按需关闭）
  "MD045": false,

  // MD009: 行尾空格（保留默认或允许 2 个空格用于 Markdown 换行）
  "MD009": {
    "br_spaces": 2
  }
}