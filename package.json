{
  "name": "personal-blog",
  "version": "0.1.0",
  "private": true,
  "description": "个人博客: Astro + Vue 前台, Hono + PostgreSQL 后台, GitHub Markdown 同步",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "new-post": "npm run new-post -w apps/web",
    "new:draft": "npm run new:draft -w apps/web",
    "new:template": "npm run new:template -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
