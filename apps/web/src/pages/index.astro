---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getFeaturedPosts, getPublishedPosts } from '../lib/posts';

const featuredPosts = await getFeaturedPosts();
const latestPosts = (await getPublishedPosts()).slice(0, 6);
---

<BaseLayout title="星河博客 · 首页">
  <section class="hero">
    <div class="container">
      <h1>你好, 我是<span class="gradient-text">星河</span></h1>
      <p>一个爱写代码也爱写字的人。这里记录我的技术探索、阅读笔记, 以及一些关于生活的胡思乱想。</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/posts/">开始阅读</a>
        <a class="btn btn-ghost" href="/about/">关于我</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2 class="section-title">精选文章</h2>
    {
      featuredPosts.length > 0 ? (
        <div class="post-grid">
          {featuredPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-state">暂无精选文章</div>
      )
    }
  </section>

  <section class="section container">
    <h2 class="section-title">最新文章</h2>
    <div class="post-grid">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
