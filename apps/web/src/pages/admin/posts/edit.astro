---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminEditor from '../../../components/vue/AdminEditor.vue';
---

<BaseLayout title="编辑文章 · 星河博客" description="编辑博客文章草稿">
  <div class="container">
    <header class="page-header">
      <h1>编辑文章</h1>
    </header>
    <!-- 静态页面无法按草稿 ID 预渲染，编辑器在客户端读取 ?id= 参数加载草稿 -->
    <AdminEditor client:load />
  </div>
</BaseLayout>
