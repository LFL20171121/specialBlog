---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoginForm from '../components/vue/LoginForm.vue';
---

<BaseLayout title="登录 / 注册 · 星河博客" description="邮箱密码登录或注册新账号">
  <div class="container">
    <header class="page-header">
      <h1>登录</h1>
      <p class="sub">登录后可以点赞文章与发表评论</p>
    </header>
    <LoginForm client:load />
  </div>
</BaseLayout>
