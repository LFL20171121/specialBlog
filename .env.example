# =====================================================
# API 服务(apps/api) 
# 复制为 .env 后按需修改, .env 已被 gitignore
# =====================================================

# PostgreSQL 连接串(本地开发默认值) 
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_blog

# API 监听端口
PORT=8787

# 会话有效期(小时) 
SESSION_TTL_HOURS=168

# 初始管理员(API 首次启动时自动创建) 
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
ADMIN_NICKNAME=站长

# 同步 worker 轮询间隔(毫秒) 
SYNC_WORKER_INTERVAL_MS=15000

# -----------------------------------------------------
# GitHub 内容同步(发布链路) 
# 不配置时发布任务会失败并进入重试流程, 用于演示失败恢复
# -----------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# 仓库内 Markdown 存放目录
CONTENT_DIR=content/posts
